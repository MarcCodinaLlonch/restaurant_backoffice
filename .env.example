# Fitxer d'exemple de variables d'entorn
ENVIRONMENT=development

DB_URL_TESTS=sqlite:///:memory:
DB_URL_DEVELOPMENT=postgresql://postgres:secretpassword@localhost:5433/restaurant_db_dev
DB_URL_PRODUCTION=postgresql://postgres:secretpassword@localhost:5433/restaurant_db_prod

SERVER_HOST=0.0.0.0
SERVER_PORT=8088

# Límits de seguretat de la xarxa (AsyncIO)
READ_TIMEOUT_SECONDS=5.0
MAX_BODY_SIZE=1048576

# Certificats TLS del servidor (Pràctica 3 - OpenSSL)
SSL_CERT_FILE=certs/cert.pem
SSL_KEY_FILE=certs/key.pem

# Certificat públic de confiança del client (còpia pública de cert.pem del servidor, mai la clau privada)
CLIENT_CA_FILE=certs/cert.pem



