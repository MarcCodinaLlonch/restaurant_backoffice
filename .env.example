# Fitxer d'exemple de variables d'entorn
ENVIRONMENT=development

DB_URL_TESTS=sqlite:///:memory:
DB_URL_DEVELOPMENT=postgresql://postgres:secretpassword@localhost:5433/restaurant_db_dev
DB_URL_PRODUCTION=postgresql://postgres:secretpassword@localhost:5433/restaurant_db_prod

SERVER_HOST=0.0.0.0
SERVER_PORT=8088

# Configuració de concurrència i robustesa AsyncIO
READ_TIMEOUT_SECONDS=5.0
MAX_BODY_SIZE=1048576
MAX_CONNECTIONS=50
DB_MAX_CONCURRENCY=10
